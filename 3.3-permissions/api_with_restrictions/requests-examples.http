# примеры API-запросов

@baseUrl = http://127.0.0.1:8000/api
@token = ВСТАВЬТЕ_СЮДА_ТОКЕН_ПОЛЬЗОВАТЕЛЯ

# Получить все объявления без авторизации
GET {{baseUrl}}/advertisements/
Accept: application/json

###

# Отфильтровать по статусу
GET {{baseUrl}}/advertisements/?status=OPEN
Accept: application/json

###

# Отфильтровать по создателю
GET {{baseUrl}}/advertisements/?creator=3
Accept: application/json

###

# Отфильтровать по диапазону дат
GET {{baseUrl}}/advertisements/?created_at_after=2026-01-01&created_at_before=2026-12-31
Accept: application/json

###

# Совместить фильтр по статусу и дате
GET {{baseUrl}}/advertisements/?status=OPEN&created_at_after=2026-01-01&created_at_before=2026-12-31
Accept: application/json

###

# Создать объявление
POST {{baseUrl}}/advertisements/
Content-Type: application/json
Authorization: Token {{token}}

{
  "title": "Шкаф IKEA",
  "description": "Срочно"
}

###

# Изменить статус объявления
PATCH {{baseUrl}}/advertisements/1/
Content-Type: application/json
Authorization: Token {{token}}

{
  "status": "CLOSED"
}

###

# Удалить объявление
DELETE {{baseUrl}}/advertisements/1/
Authorization: Token {{token}}